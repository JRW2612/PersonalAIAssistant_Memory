# Production Secrets Template - Fill with Base64 values or inject via HashiCorp Vault / External Secrets Operator
apiVersion: v1
kind: Secret
metadata:
  name: bfsi-memory-secrets
  namespace: bfsi-memory-prod
  labels:
    app: memory-api
    tier: backend
type: Opaque
stringData:
  # Sovereign Database Connection Strings (PostgreSQL in ap-south-1 / centralindia)
  ConnectionStrings__DefaultConnection: "Host=postgres-primary.internal.ap-south-1.rds.amazonaws.com;Port=5432;Database=bfsi_memory_prod;Username=memory_admin;Password=REPLACE_WITH_STRONG_PASSWORD;SslMode=Require;Trust Server Certificate=true;Pooling=true;MinPoolSize=20;MaxPoolSize=200;"

  # Sovereign Qdrant Cluster Endpoint
  Qdrant__Endpoint: "https://qdrant-cluster.internal.ap-south-1.bfsi.bank:6334"
  Qdrant__ApiKey: "REPLACE_WITH_PRODUCTION_QDRANT_API_KEY"

  # Cloud HSM / Managed HSM Authentication Credentials
  AZURE_TENANT_ID: "REPLACE_WITH_AZURE_AD_TENANT_ID"
  AZURE_CLIENT_ID: "REPLACE_WITH_MANAGED_HSM_APP_CLIENT_ID"
  AZURE_CLIENT_SECRET: "REPLACE_WITH_MANAGED_HSM_APP_CLIENT_SECRET"
  AWS_KMS_KEY_ARN: "arn:aws:kms:ap-south-1:123456789012:key/bfsi-prod-cmk-hsm-001"

  # Enterprise JWT Signing Secret (Retrieved from HSM in Production)
  JWT_SECRET: "REPLACE_WITH_FIPS_PROTECTED_JWT_SIGNING_SECRET"

  # Microsoft Teams SOC Notification Webhook
  TEAMS_SECURITY_WEBHOOK_URL: "https://outlook.office.com/webhook/REPLACE_WITH_PRODUCTION_SECURITY_CHANNEL_WEBHOOK"
