{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "PersonalAIAssistant.Memory": "Information"
    }
  },
  "AllowedHosts": "*.bank.internal;*.prod.bfsi.cloud",
  "UseInMemoryStore": false,
  "ConnectionStrings": {
    "PostgresReadModel": "Host=prod-pg-primary.internal.ap-south-1.rds.amazonaws.com;Port=5432;Database=BfsiMemoryReadDb;Username=memory_admin;Password=${POSTGRES_PROD_PASSWORD};SSL Mode=Require;Trust Server Certificate=false;Pooling=true;MinPoolSize=20;MaxPoolSize=200;Connection Lifetime=300;",
    "MongoEventStore": "mongodb://memory_app:${MONGO_PROD_PASSWORD}@prod-mongo-01.internal.ap-south-1.docdb.amazonaws.com:27017,prod-mongo-02.internal.ap-south-1.docdb.amazonaws.com:27017/BfsiMemoryEventStore?replicaSet=rs0&readPreference=secondaryPreferred&ssl=true&authSource=admin",
    "Redis": "prod-redis-cluster.internal.ap-south-1.cache.amazonaws.com:6379,ssl=true,password=${REDIS_PROD_PASSWORD},abortConnect=false"
  },
  "Jwt": {
    "Issuer": "https://identity.bfsi-memory.bank.internal",
    "Audience": "https://api.bfsi-memory.bank.internal",
    "SecretKey": "${JWT_SIGNING_SECRET_FROM_HSM}"
  },
  "Encryption": {
    "Enabled": true,
    "SystemKey": "${MASTER_ENCRYPTION_KEY_FROM_HSM}"
  },
  "Hsm": {
    "Provider": "AzureKeyVaultManagedHsm",
    "KeyVaultUri": "https://bfsi-core-prod-hsm.managedhsm.azure.net/",
    "KmsRegion": "ap-south-1",
    "KmsKeyId": "arn:aws:kms:ap-south-1:123456789012:key/bfsi-prod-cmk-hsm-001",
    "JwtSecretKeyName": "ProductionBfsiJwtSigningKey",
    "MasterKeyName": "ProductionBfsiMasterKek",
    "FipsComplianceLevel": "FIPS 140-2 Level 3",
    "EnforceHardwareSecurityModule": true,
    "AutoZeroizeMemory": true
  },
  "BfsiCompliance": {
    "DataLocalization": {
      "EnforceIndiaRegionOnly": true,
      "AllowedCloudRegions": [ "ap-south-1", "ap-south-2", "centralindia", "southindia" ],
      "BlockCrossBorderEgress": true,
      "OffshorePurgeWindowHours": 24,
      "CertInComplianceMode": true,
      "LogRetentionDays": 180
    }
  },
  "EnterpriseSso": {
    "Enabled": true,
    "DefaultProtocol": "OIDC",
    "SpEntityId": "https://api.bfsi-memory.bank.internal/sp",
    "AssertionConsumerServiceUrl": "https://api.bfsi-memory.bank.internal/api/v1/auth/enterprise/saml",
    "Providers": [
      {
        "TenantId": "tenant-hdfc-prod",
        "Domain": "hdfcbank.com",
        "Protocol": "OIDC",
        "Authority": "https://login.microsoftonline.com/8f6e52c4-2b63-4a67-83d1-4475510f2742/v2.0",
        "ClientId": "api://bfsi-ai-assistant-hdfc",
        "Audience": "api://bfsi-ai-assistant-hdfc",
        "RequireMfa": true
      },
      {
        "TenantId": "tenant-icici-prod",
        "Domain": "icicibank.com",
        "Protocol": "SAML2",
        "Authority": "https://sso.icicibank.com/idp/primo",
        "ClientId": "bfsi-ai-assistant-icici-sp",
        "Audience": "https://api.bfsi-memory.bank.internal/sp",
        "RequireMfa": true
      },
      {
        "TenantId": "tenant-sbi-prod",
        "Domain": "sbi.co.in",
        "Protocol": "OIDC",
        "Authority": "https://iam.sbi.co.in/auth/realms/sbi-internal",
        "ClientId": "bfsi-memory-assistant-sbi",
        "Audience": "bfsi-memory-assistant-sbi",
        "RequireMfa": true
      }
    ]
  },
  "AI": {
    "Default": "gemini",
    "Enabled": true,
    "Gemini": {
      "ApiKey": "${GOOGLE_GEMINI_ENTERPRISE_API_KEY}",
      "ConsolidationModel": "gemini-1.5-flash",
      "CompressionModel": "gemini-1.5-flash",
      "MaxOutputTokens": 2048,
      "Temperature": 0.2
    },
    "OpenAi": {
      "ApiKey": "${AZURE_OPENAI_CENTRALINDIA_API_KEY}",
      "Endpoint": "https://bfsi-openai-centralindia.openai.azure.com/",
      "ConsolidationModel": "gpt-4o-mini",
      "CompressionModel": "gpt-4o-mini"
    }
  },
  "Qdrant": {
    "Host": "prod-qdrant-cluster.internal.ap-south-1.aws",
    "Port": 6334,
    "Https": true,
    "ApiKey": "${QDRANT_PROD_API_KEY}",
    "CollectionName": "bfsi_memory_vectors_v1"
  },
  "Tracing": {
    "Provider": "OTLP",
    "RetentionHours": 720,
    "OTLP": {
      "Endpoint": "https://prod-otel-collector.internal.ap-south-1.aws:4317"
    }
  }
}
