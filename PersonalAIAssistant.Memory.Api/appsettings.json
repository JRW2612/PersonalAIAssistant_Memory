{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "UseInMemoryStore": true,
  "ConnectionStrings": {
    "PostgresReadModel": "Host=localhost;Database=PersonalAiMemoryReadDb;Username=postgres;Password=postgres",
    "MongoEventStore": "mongodb://localhost:27017"
  },
  "Jwt": {
    // SEC-02: Do NOT commit usable JWT signing keys. For local development, override via:
    //   dotnet user-secrets set "Jwt:SecretKey" "<your-dev-key>"
    // or set environment variable: Jwt__SecretKey=<your-dev-key>
    "SecretKey": "REPLACE-WITH-USER-SECRETS-OR-ENV-VAR-FOR-LOCAL-DEV",
    "Issuer": "PersonalAIAssistant.Memory",
    "Audience": "PersonalAIAssistant.Memory.Api"
  },
  "Encryption": {
    "Enabled": true,
    // SEC-02: Do NOT commit usable encryption keys. Override via user-secrets or env var:
    //   Encryption__SystemKey=<your-dev-key>
    "SystemKey": "REPLACE-WITH-USER-SECRETS-OR-ENV-VAR-FOR-LOCAL-DEV"
  },
  "Hsm": {
    "Provider": "SimulatedHsm",
    "FipsComplianceLevel": "FIPS 140-2 Level 3",
    "EnforceHardwareSecurityModule": true,
    "MasterKeyName": "EnterpriseMemoryMasterKey",
    "JwtSecretKeyName": "JwtSigningSecret"
  },
  "EnterpriseSso": {
    "Enabled": true,
    "SpEntityId": "https://memory.ai-assistant.internal/sp",
    "AssertionConsumerServiceUrl": "https://memory.ai-assistant.internal/api/v1/auth/enterprise/saml"
  },
  "AI": {
    "Default": "gemini",
    "Enabled": true,
    "OpenAi": {
      "ApiKey": "sk-placeholder-key-for-openai-api",
      "ConsolidationModel": "gpt-4o-mini",
      "CompressionModel": "gpt-3.5-turbo"
    },
    "Gemini": {
      "ApiKey": "",
      "ConsolidationModel": "gemini-1.5-flash",
      "CompressionModel": "gemini-1.5-flash",
      "MaxOutputTokens": 1024,
      "Temperature": 0.3
    }
  },
  "AiGateway": {
    "Enabled": true,
    "BaseUrl": "http://localhost:8080/v1/",
    "TimeoutSeconds": 60
  },
  "MemoryIngestion": {
    "Enabled": true,
    "RedactSensitiveData": true,
    "MaxTags": 20,
    "MaxTagLength": 64
  },
  "Qdrant": {
    "Host": "localhost",
    "Port": 6334,
    "Https": false,
    "CollectionName": "ai_memory_vectors"
  },
  "Chunking": {
    "Enabled": true,
    "MaxTokens": 500,
    "OverlapTokens": 50
  },
  "Retention": {
    "MaxMemoriesPerUser": 1000,
    "TtlDays": 30
  },
  "ConversationBuffer": {
    "MaxTurns": 20,
    "FlushThreshold": 10,
    "SessionTtlMinutes": 60,
    "AutoFlushToMemory": true
  },
  "AgentTracing": {
    "Enabled": true,
    "MaxTraces": 10000,
    "RetentionHours": 168
  },
  "Tracing": {
    "Provider": "OTLP",
    "RetentionHours": 168,
    "OTLP": {
      "Endpoint": "http://localhost:4317"
    }
  },
  "Authorization": {
    "Roles": {
      "SupportAgent": [
        "ai.memory.read",
        "ai.memory.diagnostics",
        "ai.memory.support"
      ]
    }
  }
}
