{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "UseInMemoryStore": true,
  "ConnectionStrings": {
    "PostgresReadModel": "Host=localhost;Database=PersonalAiMemoryReadDb;Username=postgres;Password=postgres",
    "MongoEventStore": "mongodb://localhost:27017"
  },
  "Jwt": {
    "SecretKey": "SuperSecretJwtAuthenticationSigningKey32BytesLongStringForHmacSha256!",
    "Issuer": "PersonalAIAssistant.Memory",
    "Audience": "PersonalAIAssistant.Memory.Api"
  },
  "Encryption": {
    "Enabled": true,
    "SystemKey": "ProductionSystemEncryptionKey32BytesLongSecretString!"
  },
  "AI": {
    "Default": "gemini",
    "Enabled": true,
    "OpenAi": {
      "ApiKey": "sk-placeholder-key-for-openai-api",
      "ConsolidationModel": "gpt-4o-mini",
      "CompressionModel": "gpt-3.5-turbo"
    },
    "Gemini": {
      "ApiKey": "",
      "ConsolidationModel": "gemini-1.5-flash",
      "CompressionModel": "gemini-1.5-flash",
      "MaxOutputTokens": 1024,
      "Temperature": 0.3
    }
  },
  "AiGateway": {
    "Enabled": true,
    "BaseUrl": "http://localhost:8080/v1/",
    "TimeoutSeconds": 60
  },
  "MemoryIngestion": {
    "Enabled": true,
    "RedactSensitiveData": true,
    "MaxTags": 20,
    "MaxTagLength": 64
  },
  "Qdrant": {
    "Host": "localhost",
    "Port": 6334,
    "Https": false,
    "CollectionName": "ai_memory_vectors"
  },
  "Chunking": {
    "Enabled": true,
    "MaxTokens": 500,
    "OverlapTokens": 50
  },
  "Retention": {
    "MaxMemoriesPerUser": 1000,
    "TtlDays": 30
  }
}
